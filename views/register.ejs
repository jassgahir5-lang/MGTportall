<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register — Campus Event & Pass Portal</title>
  <meta name="description" content="Create your student profile and unlock seamless campus event registration.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div class="liquid-canvas">
    <div class="liquid-orb liquid-orb-1"></div>
    <div class="liquid-orb liquid-orb-2"></div>
    <div class="liquid-orb liquid-orb-3"></div>
  </div>

  <div class="auth-split-wrapper">
    <div class="container" style="max-width: 1080px;">
      <div class="row g-0 align-items-stretch shadow-lg" style="border-radius: var(--radius-xl); overflow: hidden;">

        <div class="col-lg-5 auth-showcase-box">
          <div>
            <div class="d-flex align-items-center gap-3 mb-4">
              <div class="brand-icon-nav" style="width: 46px; height: 46px; font-size: 1.3rem;">
                <i class="bi bi-person-plus-fill"></i>
              </div>
              <div>
                <h4 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">STUDENT ONBOARDING</h4>
                <small class="text-white-50" style="font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase;">Official Portal Account</small>
              </div>
            </div>

            <div class="hero-badge mb-3">
              <span class="dot"></span> University Verified
            </div>

            <h2 class="fw-extrabold text-white mb-3" style="font-size: 1.9rem; letter-spacing: -0.03em; line-height: 1.2;">
              Join Campus Activities with a <span style="background: var(--grad-liquid); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Single Digital Pass</span>
            </h2>

            <p class="text-white-50 fs-6 mb-4" style="line-height: 1.6;">
              Sign up once to access cultural fests, technical hackathons, guest seminars, and athletic tournaments across all departments.
            </p>

            <div class="d-flex flex-column gap-3 mb-4">
              <div class="d-flex align-items-start gap-3">
                <div class="p-2 rounded-3 bg-white bg-opacity-10 text-cyan">
                  <i class="bi bi-ticket-perforated-fill fs-5 text-info"></i>
                </div>
                <div>
                  <h6 class="text-white fw-bold mb-0">Cryptographic QR Passes</h6>
                  <small class="text-white-50" style="font-size: 0.8rem;">Tamper-proof digital tokens scan instantly at auditorium entrances.</small>
                </div>
              </div>

              <div class="d-flex align-items-start gap-3">
                <div class="p-2 rounded-3 bg-white bg-opacity-10">
                  <i class="bi bi-award-fill fs-5 text-warning"></i>
                </div>
                <div>
                  <h6 class="text-white fw-bold mb-0">Academic Attendance Credit</h6>
                  <small class="text-white-50" style="font-size: 0.8rem;">Automatic logging of verified attendance for activity certificates.</small>
                </div>
              </div>

              <div class="d-flex align-items-start gap-3">
                <div class="p-2 rounded-3 bg-white bg-opacity-10">
                  <i class="bi bi-bell-fill fs-5 text-success"></i>
                </div>
                <div>
                  <h6 class="text-white fw-bold mb-0">Live Venue & Time Updates</h6>
                  <small class="text-white-50" style="font-size: 0.8rem;">Instant notifications if schedules, halls, or seat rosters adjust.</small>
                </div>
              </div>
            </div>
          </div>

          <div class="pt-3 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
            <span class="text-white-50 fs-7"><i class="bi bi-lock-fill text-success me-1"></i> End-to-End Encrypted Data</span>
            <span class="text-white-50 fs-7">Term: Fall 2026</span>
          </div>
        </div>

        <div class="col-lg-7 auth-card-side d-flex flex-column justify-content-center">
          
          <div class="mb-4">
            <h3 class="fw-extrabold text-dark mb-1" style="letter-spacing: -0.03em;">Create Student Account</h3>
            <p class="text-secondary fs-7 mb-0">Enter your details to generate your campus credentials.</p>
          </div>

          <% if (error) { %>
            <div class="alert-liquid alert-liquid-danger mb-4" role="alert">
              <i class="bi bi-exclamation-octagon-fill fs-5"></i>
              <div><%= error %></div>
            </div>
          <% } %>

          <form action="/auth/register" method="POST">
            
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label-glass">
                  <i class="bi bi-person"></i> Full Name
                </label>
                <div class="input-group input-group-glass">
                  <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                  <input type="text" name="name" class="form-control form-control-glass" placeholder="Alex Rivera" required>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label-glass">
                  <i class="bi bi-envelope"></i> College Email
                </label>
                <div class="input-group input-group-glass">
                  <span class="input-group-text"><i class="bi bi-envelope-at"></i></span>
                  <input type="email" name="email" class="form-control form-control-glass" placeholder="alex@college.edu" required>
                </div>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label-glass">
                  <i class="bi bi-building"></i> Academic Department
                </label>
                <div class="input-group input-group-glass">
                  <span class="input-group-text"><i class="bi bi-mortarboard-fill"></i></span>
                  <select name="department_id" id="department_id" class="form-select form-select-glass" required>
                    <option value="" disabled selected>-- Select Academic Department --</option>
                    <% if (departments && departments.length > 0) { %>
                      <% departments.forEach(dept => { %>
                        <option value="<%= dept.id %>"><%= dept.name %></option>
                      <% }); %>
                    <% } else { %>
                      <option value="" disabled>No departments loaded</option>
                    <% } %>
                  </select>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label-glass">
                  <i class="bi bi-lock"></i> Account Password
                </label>
                <div class="input-group input-group-glass">
                  <span class="input-group-text"><i class="bi bi-key"></i></span>
                  <input type="password" name="password" class="form-control form-control-glass" placeholder="Min. 6 characters" required>
                </div>
              </div>
            </div>

            <div class="p-3 mb-4 rounded-3" style="background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.2);">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-success fs-6"></i>
                <small class="text-secondary" style="font-size: 0.78rem;">
                  By registering, your account will be activated immediately with real-time seat booking authorization.
                </small>
              </div>
            </div>

            <button type="submit" class="btn-liquid w-100 py-3 mb-3">
              <span>Complete Registration & Generate Access</span>
              <i class="bi bi-check2-circle fs-6"></i>
            </button>
          </form>

          <div class="text-center pt-2 border-top border-light-subtle">
            <p class="text-secondary fs-7 mb-0">Already registered? 
              <a href="/auth/login" class="fw-bold text-primary text-decoration-none ms-1">Sign In to Account</a>
            </p>
          </div>

        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
