<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Directory & Access Moderation — Campus Admin</title>
  <meta name="description" content="Manage enrolled student profiles, audit department allocations, and moderate account access.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div class="liquid-canvas">
    <div class="liquid-orb liquid-orb-1"></div>
    <div class="liquid-orb liquid-orb-2"></div>
    <div class="liquid-orb liquid-orb-3"></div>
  </div>

  <nav class="navbar navbar-expand-lg navbar-dark navbar-portal sticky-top py-3">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard">
        <div class="brand-icon-nav" style="background: linear-gradient(135deg, #4f46e5, #06b6d4);">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <span>CAMPUS ADMIN COMMAND</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/admin/dashboard" class="btn-nav-logout">
          <i class="bi bi-grid-fill me-1"></i> Dashboard
        </a>
        <a href="/admin/events/create" class="btn-nav-logout">
          <i class="bi bi-plus-circle me-1"></i> New Event
        </a>
        <div class="user-pill d-none d-md-flex">
          <i class="bi bi-person-circle fs-6" style="color: var(--liquid-cyan);"></i>
          <span><%= user.name %></span>
          <span class="role-badge" style="background: linear-gradient(135deg, #ec4899, #8b5cf6);">Administrator</span>
        </div>
        <a href="/auth/logout" class="btn-nav-logout">
          <i class="bi bi-box-arrow-right me-1"></i> Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-5">

    <% if (message) { %>
      <div class="alert-liquid alert-liquid-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div><%= message %></div>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert-liquid alert-liquid-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3 animate-in">
      <div>
        <div class="hero-badge mb-2" style="font-size: 0.72rem; padding: 4px 14px;">
          <span class="dot"></span> USER ACCOUNTS & ENROLLMENT
        </div>
        <h2 class="fw-extrabold mb-1" style="letter-spacing: -0.03em;">Student Directory & Moderation</h2>
        <p class="text-secondary mb-0 fs-6">Audit verified university student profiles, track event pass holdings, and manage portal authorizations.</p>
      </div>

      <div class="d-flex gap-2">
        <a href="/admin/dashboard" class="btn btn-glass-secondary">
          <i class="bi bi-arrow-left"></i> Back to Events
        </a>
      </div>
    </div>

    <div class="row g-3 mb-4 animate-in animate-delay-1">
      <div class="col-6 col-md-4">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Total Registered Students</span>
            <div class="stat-icon-wrap icon-liquid-emerald">
              <i class="bi bi-mortarboard-fill"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= students.length %></div>
            <div class="stat-subtext">
              <i class="bi bi-check-circle-fill text-success"></i> Academic accounts
            </div>
          </div>
        </div>
      </div>

      <% 
        const activeCount = students.filter(s => s.status === 'active').length;
        const totalPasses = students.reduce((acc, s) => acc + parseInt(s.passes_count || 0, 10), 0);
      %>

      <div class="col-6 col-md-4">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Active Authorizations</span>
            <div class="stat-icon-wrap icon-liquid-indigo">
              <i class="bi bi-shield-check"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= activeCount %> / <%= students.length %></div>
            <div class="stat-subtext">
              <i class="bi bi-person-check-fill text-primary"></i> Permitted to book passes
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Total Student Passes Held</span>
            <div class="stat-icon-wrap icon-liquid-violet">
              <i class="bi bi-ticket-perforated-fill"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= totalPasses %></div>
            <div class="stat-subtext">
              <i class="bi bi-qr-code text-purple"></i> Active gate reservations
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="glass-table-card animate-in animate-delay-2">
      <div class="glass-table-header">
        <div>
          <h5 class="fw-bold mb-1">Enrolled Student Accounts</h5>
          <small class="text-secondary">Search, audit, and toggle student portal authorization.</small>
        </div>

        <div class="search-box-glass" style="min-width: 280px;">
          <i class="bi bi-search search-icon"></i>
          <input type="text" id="studentSearchInput" class="form-control" placeholder="Search student by name, email, dept..." onkeyup="filterStudents()">
        </div>
      </div>

      <div class="table-responsive">
        <table class="custom-glass-table align-middle" id="studentsTable">
          <thead>
            <tr>
              <th>#</th>
              <th>Student Profile</th>
              <th>Institutional Email</th>
              <th>Academic Department</th>
              <th>Passes Booked</th>
              <th>Status</th>
              <th class="text-end">Access Control</th>
            </tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5">
                  <div class="py-4">
                    <i class="bi bi-people text-muted fs-1 d-block mb-3"></i>
                    <h5 class="fw-bold text-dark mb-1">No Student Accounts Found</h5>
                    <p class="text-secondary fs-7 mb-0">Students will appear here once they complete the onboarding registration.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% students.forEach((student, index) => { %>
                <% 
                  const initials = student.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                  const isBlocked = student.status === 'blocked';
                %>
                <tr>
                  <td class="fw-bold text-muted fs-7"><%= index + 1 %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-8" style="width: 36px; height: 36px; background: <%= isBlocked ? '#94a3b8' : 'var(--grad-liquid)' %>;">
                        <%= initials %>
                      </div>
                      <div>
                        <div class="fw-bold text-dark"><%= student.name %></div>
                        <small class="text-muted fs-8">Joined: <%= new Date(student.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></small>
                      </div>
                    </div>
                  </td>
                  <td class="text-secondary fs-7"><%= student.email %></td>
                  <td>
                    <span class="badge-cat-glass"><%= student.department_name || 'General Studies' %></span>
                  </td>
                  <td>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 fs-8">
                      <i class="bi bi-ticket-fill me-1"></i> <%= student.passes_count %> passes
                    </span>
                  </td>
                  <td>
                    <% if (isBlocked) { %>
                      <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-2 py-1 fs-8">
                        <i class="bi bi-slash-circle-fill me-1"></i> Suspended
                      </span>
                    <% } else { %>
                      <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 fs-8">
                        <i class="bi bi-check-circle-fill me-1"></i> Active
                      </span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <form action="/admin/students/<%= student.id %>/toggle-status" method="POST" class="d-inline" onsubmit="return confirm('<%= isBlocked ? 'Reactivate' : 'Suspend' %> access for <%= student.name %>?');">
                      <% if (isBlocked) { %>
                        <button type="submit" class="btn btn-sm btn-liquid py-1 px-3">
                          <i class="bi bi-unlock-fill me-1"></i> Reactivate
                        </button>
                      <% } else { %>
                        <button type="submit" class="btn btn-sm btn-glass-secondary text-danger py-1 px-3">
                          <i class="bi bi-slash-circle me-1"></i> Suspend
                        </button>
                      <% } %>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function filterStudents() {
      const query = document.getElementById('studentSearchInput').value.toLowerCase();
      const rows = document.querySelectorAll('#studentsTable tbody tr');

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        if (text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }
  </script>
</body>
</html>
