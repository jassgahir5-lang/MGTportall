<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendee Roster — <%= event.title %></title>
  <meta name="description" content="Official student attendance manifest and entry pass validation roster for <%= event.title %>.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div class="liquid-canvas">
    <div class="liquid-orb liquid-orb-1"></div>
    <div class="liquid-orb liquid-orb-2"></div>
    <div class="liquid-orb liquid-orb-3"></div>
  </div>

  <nav class="navbar navbar-expand-lg navbar-dark navbar-portal sticky-top py-3 no-print">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard">
        <div class="brand-icon-nav" style="background: linear-gradient(135deg, #4f46e5, #06b6d4);">
          <i class="bi bi-people-fill"></i>
        </div>
        <span>CAMPUS ATTENDEE ROSTER</span>
      </a>
      <div class="d-flex align-items-center gap-3">
        <a href="/admin/dashboard" class="btn-nav-logout">
          <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
        <a href="/admin/students" class="btn-nav-logout">
          <i class="bi bi-person-lines-fill me-1"></i> Student Directory
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-5">

    <% if (locals.message) { %>
      <div class="alert-liquid alert-liquid-success mb-4 no-print" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div><%= message %></div>
      </div>
    <% } %>

    <% if (locals.error) { %>
      <div class="alert-liquid alert-liquid-danger mb-4 no-print" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <div class="glass-panel p-4 mb-4 animate-in">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <span class="badge-cat-glass"><%= event.category_name || 'Campus Event' %></span>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 fs-8">Status: <%= (event.status || 'upcoming').toUpperCase() %></span>
            <span class="text-secondary fs-8"><i class="bi bi-geo-alt-fill text-primary me-1"></i><%= event.venue_name || 'Main Hall' %></span>
            <span class="text-secondary fs-8"><i class="bi bi-calendar-event-fill text-info me-1"></i><%= new Date(event.start_time).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
          </div>
          <h2 class="fw-extrabold mb-1" style="letter-spacing: -0.03em;"><%= event.title %></h2>
          <p class="text-secondary fs-7 mb-0">Official student entry pass manifest and gate check-in roster.</p>
        </div>

        <div class="d-flex align-items-center gap-2 no-print flex-wrap">
          <a href="/admin/events/<%= event.id %>/edit" class="btn btn-glass-secondary py-2 px-3 fs-8">
            <i class="bi bi-pencil-square"></i> Edit Event
          </a>
          <a href="/admin/events/<%= event.id %>/export-csv" class="btn-liquid py-2 px-3 fs-8">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export CSV
          </a>
          <button class="btn-liquid-outline py-2 px-3 fs-8" onclick="window.print()">
            <i class="bi bi-printer-fill"></i> Print Roster
          </button>
        </div>
      </div>
    </div>

    <% 
      const totalEnrolled = attendees.length;
      const capacity = parseInt(event.capacity || 1, 10);
      const remainingSeats = Math.max(capacity - totalEnrolled, 0);
      const percentFilled = Math.min(Math.round((totalEnrolled / capacity) * 100), 100);
      const checkedInCount = attendees.filter(a => a.attendance_id).length;
      const checkInRate = totalEnrolled > 0 ? Math.round((checkedInCount / totalEnrolled) * 100) : 0;
    %>
    <div class="row g-3 mb-4 animate-in animate-delay-1">
      <div class="col-6 col-md-3">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Enrolled Students</span>
            <div class="stat-icon-wrap icon-liquid-emerald">
              <i class="bi bi-person-check-fill"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= totalEnrolled %></div>
            <div class="stat-subtext">
              <i class="bi bi-check-circle-fill text-success"></i> Passes issued
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Verified Checked-In</span>
            <div class="stat-icon-wrap icon-liquid-cyan">
              <i class="bi bi-qr-code-scan"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= checkedInCount %> / <%= totalEnrolled %></div>
            <div class="stat-subtext">
              <i class="bi bi-shield-check text-info"></i> <%= checkInRate %>% attendance
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Seats Remaining</span>
            <div class="stat-icon-wrap icon-liquid-indigo">
              <i class="bi bi-diagram-3-fill"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= remainingSeats %></div>
            <div class="stat-subtext">
              <i class="bi bi-hourglass-split text-primary"></i> Out of <%= capacity %> total
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="glass-stat-card">
          <div class="d-flex align-items-center justify-content-between">
            <span class="stat-label">Hall Occupancy</span>
            <div class="stat-icon-wrap icon-liquid-violet">
              <i class="bi bi-pie-chart-fill"></i>
            </div>
          </div>
          <div>
            <div class="stat-value"><%= percentFilled %>%</div>
            <div class="progress-liquid mt-2">
              <div class="progress-bar <%= percentFilled >= 100 ? 'bg-danger' : '' %>" style="width: <%= percentFilled %>%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="glass-table-card animate-in animate-delay-2">
      <div class="glass-table-header">
        <div>
          <h5 class="fw-bold mb-0">Student Entry Manifest & Gate Check-In</h5>
          <small class="text-secondary">Verify student identities and check-in attendees in real-time.</small>
        </div>

        <div class="search-box-glass no-print" style="min-width: 260px;">
          <i class="bi bi-search search-icon"></i>
          <input type="text" id="rosterSearchInput" class="form-control" placeholder="Search student name, email, token..." onkeyup="filterRoster()">
        </div>
      </div>

      <div class="table-responsive">
        <table class="custom-glass-table align-middle" id="rosterTable">
          <thead>
            <tr>
              <th>#</th>
              <th>Student Details</th>
              <th>College Email</th>
              <th>Department</th>
              <th>Gate Check-In</th>
              <th>Pass Token ID</th>
              <th class="text-end no-print">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (attendees.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5">
                  <div class="py-4">
                    <i class="bi bi-people text-muted fs-1 d-block mb-3"></i>
                    <h5 class="fw-bold text-dark mb-1">No Student Registrations Yet</h5>
                    <p class="text-secondary fs-7 mb-0">Registered students will appear here in real-time as they book passes.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% attendees.forEach((student, index) => { %>
                <% 
                  const initials = student.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                  const isCheckedIn = !!student.attendance_id;
                %>
                <tr>
                  <td class="fw-bold text-muted fs-7"><%= index + 1 %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-8" style="width: 34px; height: 34px; background: <%= isCheckedIn ? '#10b981' : 'var(--grad-liquid)' %>;">
                        <%= initials %>
                      </div>
                      <div>
                        <div class="fw-bold text-dark"><%= student.name %></div>
                        <small class="text-success fs-8"><i class="bi bi-shield-fill-check"></i> Verified Student</small>
                      </div>
                    </div>
                  </td>
                  <td class="text-secondary fs-7"><%= student.email %></td>
                  <td>
                    <span class="badge-cat-glass"><%= student.department_name || 'General' %></span>
                  </td>
                  <td>
                    <% if (isCheckedIn) { %>
                      <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 fs-8">
                        <i class="bi bi-check-circle-fill me-1"></i> Checked In
                      </span>
                      <small class="text-muted d-block fs-8 mt-1"><%= new Date(student.scanned_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small>
                    <% } else { %>
                      <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-2 py-1 fs-8">
                        <i class="bi bi-hourglass-split me-1"></i> Pending
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <span class="ticket-id-badge text-dark" style="background: rgba(99, 102, 241, 0.1); border-color: rgba(99, 102, 241, 0.25);">
                      #TKN-00<%= student.reg_id %>
                    </span>
                  </td>
                  <td class="text-end no-print">
                    <form action="/admin/events/<%= event.id %>/attendees/<%= student.reg_id %>/toggle-attendance" method="POST" class="d-inline">
                      <% if (isCheckedIn) { %>
                        <button type="submit" class="btn btn-sm btn-glass-secondary text-secondary py-1 px-3" title="Revert attendance mark">
                          <i class="bi bi-arrow-counterclockwise"></i> Undo
                        </button>
                      <% } else { %>
                        <button type="submit" class="btn btn-sm btn-liquid py-1 px-3" title="Scan / check-in student">
                          <i class="bi bi-qr-code-scan me-1"></i> Check In
                        </button>
                      <% } %>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function filterRoster() {
      const query = document.getElementById('rosterSearchInput').value.toLowerCase();
      const rows = document.querySelectorAll('#rosterTable tbody tr');

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        if (text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }
  </script>
</body>
</html>
